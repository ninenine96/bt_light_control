#!/usr/bin/env python3
"""Taskbar tray icon for the ambient hue-sync daemon (KDE Plasma / PySide6).

Shows the strip's current hue as the glowing core of a minimal white line-art
light-bulb icon, lets you pause/resume the sync with one click, and switch the
colour algorithm from a menu — all live over the daemon's Unix control socket
(control_socket.default_socket_path).

    ambienttray                # run the tray (in the foreground)
    ambienttray --socket P     # override control-socket path
    ambienttray install        # write ~/.config/systemd/user/ambient-tray.service
    ambienttray enable         # systemctl --user enable --now ambient-tray.service
    ambienttray disable        # systemctl --user disable --now ambient-tray.service
    ambienttray uninstall      # remove the unit + daemon-reload

Left-click the tray icon toggles the sync on/off; right-click opens a menu
with the face status, a Pause/Resume toggle, the algorithm radio list, and
Start/Stop daemon actions.  The daemon does not need to be running: the tray
keeps living and offers to start the systemd unit (or stop it).

Requires PySide6 (TrayIcon -> native StatusNotifier on Plasma).
"""

import argparse
import sys
from pathlib import Path

from coloralg import ALGORITHMS
from control_socket import default_socket_path, send_command
from systemd_user import install_cli, render_user_unit, systemctl, uninstall_cli
from tray_icon import render_icon

# Qt is imported once, guarded, so `ambienttray install` still works headless
# and without PySide6. The Tray class below only touches these names at call
# time, so a missing Qt fails when the UI actually runs (main catches it).
try:
    from PySide6.QtCore import QTimer
    from PySide6.QtGui import QAction, QColor
    from PySide6.QtWidgets import QApplication, QMenu, QSystemTrayIcon
    _QT_OK = True
except ImportError:  # pragma: no cover - depends on host
    _QT_OK = False

_SERVICE_FILENAME = "ambient-tray.service"
# how often to refresh from the daemon socket, seconds
_POLL_INTERVAL_MS = 1000


def send_or_none(cmd: str, socket_path: str) -> dict | None:
    """send_command, but return None when the daemon is unreachable."""
    try:
        return send_command(cmd, socket_path)
    except Exception:
        return None


def _status(socket_path: str) -> dict | None:
    return send_or_none("status", socket_path)


def _set_on(socket_path: str, on: bool) -> dict | None:
    return send_or_none("on" if on else "off", socket_path)


def _set_algo(socket_path: str, algo: str) -> dict | None:
    return send_or_none(f"algo {algo}", socket_path)


def _set_reactivity(socket_path: str, level: float) -> dict | None:
    return send_or_none(f"reactivity {level}", socket_path)


def _build_speed_panel(on_commit):
    """Create the reaction-speed slider widget (Qt imported lazily).

    Plasma renders the tray menu over DBusMenu, which cannot host arbitrary
    widgets, so the slider lives in its own small tool window opened from the
    menu rather than embedded in the QMenu.

    `on_commit(level)` is called (debounced) once the user settles on a value.
    The returned widget exposes `.sync(level, alpha, max_step)` to reflect the
    daemon's current state without echo-looping back a socket write.
    """
    from PySide6.QtCore import Qt, QTimer
    from PySide6.QtGui import QCursor
    from PySide6.QtWidgets import (
        QHBoxLayout,
        QLabel,
        QSlider,
        QVBoxLayout,
        QWidget,
    )

    class SpeedPanel(QWidget):
        def __init__(self) -> None:
            super().__init__(None, Qt.Tool | Qt.WindowStaysOnTopHint)
            self.setWindowTitle("Reaction speed")
            self.setFixedWidth(280)
            self.dragging = False
            lay = QVBoxLayout(self)
            title = QLabel("Reaction speed")
            f = title.font()
            f.setBold(True)
            title.setFont(f)
            self.slider = QSlider(Qt.Horizontal)
            self.slider.setRange(0, 100)
            self.slider.setValue(50)
            self.value_lbl = QLabel("50 / 100")
            self.value_lbl.setAlignment(Qt.AlignCenter)
            hint = QHBoxLayout()
            hint.addWidget(QLabel("smooth"))
            hint.addStretch(1)
            hint.addWidget(QLabel("quick"))
            lay.addWidget(title)
            lay.addWidget(self.slider)
            lay.addWidget(self.value_lbl)
            lay.addLayout(hint)

            # debounce: only send to the daemon once the user pauses dragging
            self.send_timer = QTimer(self)
            self.send_timer.setSingleShot(True)
            self.send_timer.setInterval(120)
            self.send_timer.timeout.connect(self._send)
            self.slider.valueChanged.connect(self._on_change)
            self.slider.sliderPressed.connect(self._on_press)

        def _on_press(self) -> None:
            self.dragging = True

        def _on_change(self, value: int) -> None:
            self.value_lbl.setText(f"{value} / 100")
            self.send_timer.start()

        def _send(self) -> None:
            self.send_timer.stop()
            self.dragging = False
            on_commit(self.slider.value())

        def show_at_cursor(self) -> None:
            self.adjustSize()
            self.move(QCursor.pos() - self.rect().center())
            self.show()
            self.raise_()
            self.activateWindow()

        def sync(self, level, alpha, max_step) -> None:
            """Reflect daemon state, unless the user is mid-drag."""
            if self.dragging or level is None:
                return
            self.slider.blockSignals(True)
            self.slider.setValue(int(round(level)))
            self.slider.blockSignals(False)
            if alpha is not None and max_step is not None:
                self.value_lbl.setText(
                    f"{int(round(level))} / 100   \u03b1 {alpha:g}   "
                    f"{max_step:g}\u00b0/write")
            else:
                self.value_lbl.setText(f"{int(round(level))} / 100")

    return SpeedPanel()


def _stop_daemon(socket_path: str) -> dict | None:
    return send_or_none("stop", socket_path)


def _build_unit(socket_path: str) -> str:
    script = Path(__file__).resolve()
    return render_user_unit(
        generated_by="ambienttray",
        description="Ambient hue-sync tray icon",
        exec_start=f"/usr/bin/env python3 {script} --socket {socket_path}",
        after="graphical-session.target ambient.service",
        syslog_identifier="ambienttray",
        syslog_comment="Attribute logs to `ambienttray`, not the `/usr/bin/env` wrapper.",
    )


def _do_install(socket_path: str) -> int:
    return install_cli(_SERVICE_FILENAME, _build_unit(socket_path), "ambienttray enable")


def _do_uninstall() -> int:
    return uninstall_cli(_SERVICE_FILENAME)


class Tray:
    """Plasma StatusNotifier tray: status, pause toggle, algo picker, slider.

    Owns all mutable UI state so the status→widget mapping is unit-testable; the
    module-level helpers (``_status``/``_set_on``/…) remain the socket client.
    """

    def __init__(self, app, socket_path: str):
        self.app = app
        self.socket_path = socket_path
        self.state: dict = {"online": False, "running": False, "linked": False,
                            "hue": None, "algo": None, "reactivity": None,
                            "alpha": None, "max_step": None}
        self.icon = QSystemTrayIcon()
        self.icon.setToolTip("ambient hue sync \u2026")
        self.menu = QMenu()
        self._build_menu()
        self.speed_panel = _build_speed_panel(self._commit_reactivity)
        self._wire()
        self.apply_status(_status(socket_path))  # first paint (sets the icon)
        self.icon.setVisible(True)               # only now that an icon exists
        self.poll = QTimer()
        self.poll.timeout.connect(self.refresh)
        self.poll.start(_POLL_INTERVAL_MS)

    def _build_menu(self) -> None:
        self.dash = QAction("status \u2026", self.menu)
        self.dash.setEnabled(False)
        self.menu.addAction(self.dash)

        self.toggle = QAction("Pause sync", self.menu)
        self.toggle.setCheckable(True)
        self.toggle.setChecked(False)  # checked = syncing; greyed when offline
        self.menu.addAction(self.toggle)

        self.algo_menu = QMenu("Colour algorithm", self.menu)
        self.algo_actions: dict[str, QAction] = {}
        for name in sorted(ALGORITHMS):
            act = QAction(name, self.algo_menu)
            act.setCheckable(True)
            self.algo_actions[name] = act
            self.algo_menu.addAction(act)
        self.menu.addMenu(self.algo_menu)

        self.speed_act = QAction("Reaction speed \u2026", self.menu)
        self.menu.addAction(self.speed_act)
        self.menu.addSeparator()

        self.start_act = QAction("Start daemon", self.menu)
        self.stop_act = QAction("Stop daemon", self.menu)
        self.menu.addAction(self.start_act)
        self.menu.addAction(self.stop_act)

        self.quit_act = QAction("Quit", self.menu)
        self.menu.addAction(self.quit_act)
        self.icon.setContextMenu(self.menu)

    def _wire(self) -> None:
        # checkable actions fire on `triggered` (a real click), never `toggled`,
        # so apply_status()'s setChecked during a poll can't loop a write back.
        self.toggle.triggered.connect(self._toggle)
        for act in self.algo_actions.values():
            act.triggered.connect(self._choose_algo)
        self.speed_act.triggered.connect(self.speed_panel.show_at_cursor)
        self.start_act.triggered.connect(self._do_start)
        self.stop_act.triggered.connect(self._do_stop)
        self.quit_act.triggered.connect(self.app.quit)
        self.icon.activated.connect(self._on_activated)

    @staticmethod
    def _brush_colour(hue_deg: float | None, running: bool, linked: bool) -> QColor:
        """Icon accent: hue when syncing, amber if unlinked, green if no hue."""
        if not running:
            return QColor(0x7A, 0x7A, 0x7A)      # gray: paused / offline
        if not linked:
            return QColor(0xE0, 0x91, 0x00)      # amber: running, no strip
        if hue_deg is None:
            return QColor(0x88, 0xD0, 0x88)      # green: ready, no hue yet
        h = (hue_deg % 360.0) / 360.0
        return QColor.fromHsvF(h, 0.95, 0.95)

    def apply_status(self, resp: dict | None) -> None:
        online = resp is not None
        if online:
            self.state.update(
                online=True,
                running=bool(resp.get("paused") is False),
                linked=bool(resp.get("connected")),
                hue=resp.get("hue"),
                algo=resp.get("algo"),
                reactivity=resp.get("reactivity"),
                alpha=resp.get("alpha"),
                max_step=resp.get("max_step"),
            )
        else:
            # keep locally-known values as a graceful fallback when offline
            self.state["online"] = False

        colour = self._brush_colour(self.state["hue"], self.state["running"],
                                    self.state["linked"])
        self.icon.setIcon(render_icon(colour.getRgb()[:3]))

        if online:
            hue_txt = (f"{self.state['hue']:.0f}\u00b0"
                       if self.state["hue"] is not None else "n/a")
            link = "linked" if self.state["linked"] else "no strip"
            react_txt = (f" \u00b7 R{self.state['reactivity']:g}"
                         if self.state["reactivity"] is not None else "")
            self.icon.setToolTip(
                f"ambient hue sync \u2014 "
                f"{'paused' if not self.state['running'] else 'running'} "
                f"\u00b7 {hue_txt} \u00b7 {link} \u00b7 {self.state['algo']}{react_txt}")
            self.toggle.setEnabled(True)
            self.toggle.setChecked(self.state["running"])
            self.toggle.setText("Resume sync" if not self.state["running"] else "Pause sync")
            self.start_act.setEnabled(False)
            self.stop_act.setEnabled(True)
            for name, act in self.algo_actions.items():
                act.setChecked(name == self.state["algo"])
            self.speed_act.setEnabled(True)
            if self.state["reactivity"] is not None:
                self.speed_act.setText(
                    f"Reaction speed \u2026  (R{self.state['reactivity']:g})")
            self.speed_panel.sync(self.state["reactivity"], self.state["alpha"],
                                  self.state["max_step"])
        else:
            self.icon.setToolTip("ambient \u2014 daemon not reachable")
            self.toggle.setEnabled(False)
            self.toggle.setText("Pause sync")
            self.start_act.setEnabled(True)
            self.stop_act.setEnabled(False)
            self.speed_act.setEnabled(False)

    def refresh(self) -> None:
        self.apply_status(_status(self.socket_path))

    def _commit_reactivity(self, level: int) -> None:
        _set_reactivity(self.socket_path, level)
        self.refresh()  # reactivity reply is partial; re-read the full status

    def _toggle(self) -> None:
        _set_on(self.socket_path, self.toggle.isChecked())
        self.refresh()  # on/off replies are partial; re-read the full status

    def _choose_algo(self) -> None:
        for name, act in self.algo_actions.items():
            if act.isChecked() and name != self.state["algo"]:
                _set_algo(self.socket_path, name)
        self.refresh()

    def _do_start(self) -> None:
        systemctl(["start", "ambient.service"], check=True)
        self.refresh()

    def _do_stop(self) -> None:
        _stop_daemon(self.socket_path)
        self.refresh()

    def _on_activated(self, reason) -> None:
        # left-click == toggle (and don't fight the menu's right-click)
        if reason == QSystemTrayIcon.ActivationReason.Trigger and self.state["online"]:
            _set_on(self.socket_path, not self.state["running"])
            self.refresh()  # on/off replies are partial; re-read full status


def _run_tray(socket_path: str) -> int:
    """Build and run the PySide6 tray icon (blocks until the tray closes)."""
    if not _QT_OK:
        raise ImportError("PySide6 is required for the tray")
    app = QApplication(sys.argv[:1])
    app.setQuitOnLastWindowClosed(False)
    Tray(app, socket_path)
    return app.exec()


def main(argv=None) -> int:
    p = argparse.ArgumentParser(
        description="Tray icon controlling the ambient hue-sync daemon.",
        formatter_class=argparse.ArgumentDefaultsHelpFormatter)
    p.add_argument("--socket", default=default_socket_path(),
                   help="control socket path")
    p.add_argument("command", nargs="?",
                   help="(run, or) install|enable|disable|uninstall")
    args = p.parse_args(argv)

    if args.command == "install":
        return _do_install(args.socket)
    if args.command == "enable":
        systemctl(["enable", "--now", _SERVICE_FILENAME], check=True)
        print("enabled + started")
        return 0
    if args.command == "disable":
        systemctl(["disable", "--now", _SERVICE_FILENAME], check=True)
        print("disabled + stopped")
        return 0
    if args.command == "uninstall":
        return _do_uninstall()
    if args.command not in (None, "run"):
        print(f"error: unknown command {args.command!r}", file=sys.stderr)
        return 2
    try:
        return _run_tray(args.socket)
    except ImportError as exc:
        print(f"error: {exc}\n  Is PySide6 installed? "
              "(pip install --user PySide6)", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
