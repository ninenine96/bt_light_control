#!/usr/bin/env python3
"""Control CLI + systemd install helper for the ambient daemon.

Talks to the daemon's Unix control socket (control_socket.default_socket_path)
for live commands (no restart needed):

    ambientctl status          # paused?, connected?, current hue, …
    ambientctl on              # resume ambient (reconnect strip)
    ambientctl off             # pause: release BLE link, hold last colour
    ambientctl stop            # shut the daemon down (applies --stop-state)

And manages the per-user systemd unit:

    ambientctl install [--mac ADDR]   # write ~/.config/systemd/user/ambient.service
    ambientctl enable                 # systemctl --user enable --now
    ambientctl disable                # systemctl --user disable --now
    ambientctl uninstall              # remove the unit + daemon-reload

Options:
    --socket PATH   override control-socket path (else AMBIENT_SOCKET env,
                    then $XDG_RUNTIME_DIR/ambient.sock).
"""

import argparse
import json
import os
import sys
from pathlib import Path

from control_socket import default_socket_path, send_command
from systemd_user import install_cli, render_user_unit, systemctl, uninstall_cli

SERVICE_FILENAME = "ambient.service"


# ---------------------------------------------------------------------------
# socket control
# ---------------------------------------------------------------------------

def _do_socket_cmd(cmd: str, socket_path: str) -> int:
    try:
        resp = send_command(cmd, socket_path)
    except (FileNotFoundError, ConnectionRefusedError, OSError) as exc:
        print(f"error: ambient daemon not reachable on {socket_path}: {exc}",
              file=sys.stderr)
        print("  Is it running? (check: systemctl --user status ambient)",
              file=sys.stderr)
        return 1
    except json.JSONDecodeError as exc:
        print(f"error: malformed daemon reply: {exc}", file=sys.stderr)
        return 1
    if not resp.get("ok"):
        print(f"error: {resp.get('error', 'unknown reply')}", file=sys.stderr)
        return 1
    if cmd == "status":
        hue = resp.get("hue")
        print(f"daemon:        {'paused' if resp['paused'] else 'running'}")
        print(f"strip link:    {'connected' if resp['connected'] else 'down'}")
        print(f"address:       {resp.get('address') or '(not linked)'}")
        hue_txt = f"{hue:.1f} deg" if hue is not None else "(none yet)"
        print(f"target hue:    {hue_txt}")
        print(f"brightness:    {resp.get('brightness')}%   algo: {resp.get('algo')}")
        print(f"reactivity:    {resp.get('reactivity')}/100 "
              f"(alpha {resp.get('alpha')}, max-step {resp.get('max_step')}°)")
        print(f"stop-state:    {resp.get('stop_state')}")
        print(f"uptime:        {resp.get('uptime')} s")
    elif cmd == "off":
        print("ambient paused; BLE link released (strip holds last colour)")
    elif cmd == "on":
        print("ambient resumed")
    elif cmd == "stop":
        print("stop requested")
    elif cmd.startswith("algo"):
        print(f"algorithm:     {resp.get('algo')}")
    elif cmd.startswith("reactivity"):
        print(f"reactivity:    {resp.get('reactivity')}/100 "
              f"(alpha {resp.get('alpha')}, max-step {resp.get('max_step')}°)")
    return 0


# ---------------------------------------------------------------------------
# systemd unit management
# ---------------------------------------------------------------------------

def _build_unit(mac: str | None) -> str:
    script = Path(__file__).resolve().parent / "ambient.py"
    sock = os.environ.get("AMBIENT_SOCKET") or default_socket_path()
    mac_arg = f" --mac {mac}" if mac else ""
    return render_user_unit(
        generated_by="ambientctl",
        description="Ambient display-to-LED hue sync",
        exec_start=f"/usr/bin/env python3 {script}{mac_arg}",
        environment=f"AMBIENT_SOCKET={sock}",
        syslog_identifier="ambient",
        restart_comment=(
            "on-failure (NOT always): a crash/device-shortage restarts the daemon, but a\n"
            "deliberate `ambientctl stop` / `systemctl --user stop` stays stopped."
        ),
        syslog_comment=(
            "Without this, logs are attributed to `env` (the ExecStart wrapper). Lines\n"
            "carry `<N>` sd-daemon priorities from log.py; SyslogLevelPrefix defaults on."
        ),
    )


def _do_install(mac: str | None) -> int:
    return install_cli(SERVICE_FILENAME, _build_unit(mac), "ambientctl enable")


def _do_uninstall() -> int:
    return uninstall_cli(SERVICE_FILENAME)


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------

def main(argv=None) -> int:
    p = argparse.ArgumentParser(
        description="Control + install CLI for the ambient hue-sync daemon.",
        formatter_class=argparse.ArgumentDefaultsHelpFormatter)
    p.add_argument("--socket", default=os.environ.get("AMBIENT_SOCKET")
                                 or default_socket_path(),
                   help="control socket path")
    p.add_argument("--mac", default=None,
                   help="strip MAC to bake into the installed unit (default: auto-scan)")
    p.add_argument("command", nargs="?",
                   help="status|on|off|algo NAME|reactivity 0-100|stop|"
                        "install|enable|disable|uninstall")
    p.add_argument("value", nargs="?",
                   help="algorithm name (`algo`) or 0-100 level (`reactivity`)")
    args = p.parse_args(argv)

    if args.command in ("status", "on", "off", "stop"):
        return _do_socket_cmd(args.command, args.socket)
    if args.command == "algo":
        if not args.value:
            print("error: usage: ambientctl algo NAME", file=sys.stderr)
            return 1
        return _do_socket_cmd(f"algo {args.value}", args.socket)
    if args.command == "reactivity":
        if args.value is None:
            print("error: usage: ambientctl reactivity 0-100", file=sys.stderr)
            return 1
        return _do_socket_cmd(f"reactivity {args.value}", args.socket)
    if args.command == "install":
        return _do_install(args.mac)
    if args.command == "enable":
        systemctl(["enable", "--now", SERVICE_FILENAME])
        print("enabled + started")
        return 0
    if args.command == "disable":
        systemctl(["disable", "--now", SERVICE_FILENAME])
        print("disabled + stopped")
        return 0
    if args.command == "uninstall":
        return _do_uninstall()
    p.print_help()
    return 2


if __name__ == "__main__":
    sys.exit(main())
